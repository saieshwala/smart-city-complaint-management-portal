# Database
DATABASE_URL=postgresql://civicconnect:civicconnect_dev@localhost:5432/civicconnect

# Redis
REDIS_URL=redis://localhost:6379

# Storage (MinIO for development)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=civicconnect
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin123
STORAGE_REGION=us-east-1

# Map Provider
MAP_PROVIDER=osm
MAP_API_KEY=

# AI Provider
AI_PROVIDER=openai
AI_API_KEY=your_openai_api_key_here

# Authentication
JWT_SECRET=your_jwt_secret_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_change_in_production

# Email (for notifications)
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@civicconnect.in

# SMS Provider
SMS_PROVIDER=console

# Application
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
ADMIN_PORT=3001
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
ADMIN_URL=http://localhost:3001

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100
